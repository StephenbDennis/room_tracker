# Target
CONFIG_IDF_TARGET="esp32s3"

# --- Bluetooth: NimBLE only (the S3 has no classic BT) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Large MTU keeps config chunking cheap and lets a full track frame ride in
# a single notification.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8

# A config write is handled synchronously on the host task: cJSON parses the
# blob recursively and NVS commits it, both from inside the GATT callback. The
# 4 kB default leaves no margin for that.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144

# --- WiFi / MQTT ---
# Only used when the config carries credentials; with reporting off the station
# is never started and the radio stays BLE-only.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16

# --- BLE / WiFi coexistence ---
# Both share one radio on the S3. BLE is the configuration path and must keep
# working while WiFi is associating, so the scheduler has to arbitrate.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- Flash and partitions ---
# The board has 16 MB; 2 MB is only the ESP-IDF default and would truncate it.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# WiFi, lwIP and the MQTT client do not fit alongside NimBLE in the 1 MB
# stock partition. See partitions.csv for why the app gets 4 MB rather than
# the 1.5 MB the "large" preset would give.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Console UART ---
# This is the serial monitor only. The LD2450 link is UART1 at 256000 and is
# configured in code; nothing here affects it.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- misc ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
